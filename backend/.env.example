# Backend-specific environment template for local development and Render
# Copy to backend/.env for local testing. Do NOT commit secrets.

# Server
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000

# CORS - comma separated origins for production (e.g. https://my-app.vercel.app)
CORS_ORIGINS=http://localhost:5173

# Piper
# If `piper` is on PATH in Linux production, set to 'piper'. For local
# Windows development you can point to the absolute piper.exe path.
PIPER_EXECUTABLE=piper
PIPER_MODEL_PATH=/app/models/piper/en_US-lessac-medium
PIPER_VOICE=en_US-lessac-medium
PIPER_TIMEOUT=60

# WebRTC
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Providers (leave empty if not used)
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_PROVIDER=sarvam
SARVAM_API_KEY=
TTS_PROVIDER=sarvam
